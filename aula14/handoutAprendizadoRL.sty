%% ============================================================
%%  handoutAprendizadoRL.sty
%%  Estilo para handouts do curso de Aprendizagem por Reforço (pt-BR)
%%  Irmão de beamerthemeAprendizadoRL.sty: mesma paleta, mesmas caixas,
%%  mesmas macros matemáticas — para classe `article`.
%%  Compilar com XeLaTeX ou LuaLaTeX.
%% ============================================================
\ProvidesPackage{handoutAprendizadoRL}[2026/08/09 Handout RL pt-BR]

\RequirePackage[a4paper, top=2.1cm, bottom=2.2cm, left=2.3cm, right=2.3cm,
                headsep=10pt, footskip=22pt]{geometry}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, shapes.geometric,
                decorations.pathmorphing, backgrounds, fit, chains}
\RequirePackage[most]{tcolorbox}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{fontspec}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{booktabs}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{hyperref}

%% ------------------------------------------------------------
%% 1. PALETA (idêntica à do tema Beamer)
%% ------------------------------------------------------------
\definecolor{rlAzul}{HTML}{16324F}
\definecolor{rlAzulClaro}{HTML}{2E5F8A}
\definecolor{rlTeal}{HTML}{18808D}
\definecolor{rlLaranja}{HTML}{E8590C}
\definecolor{rlAmbar}{HTML}{F2A93B}
\definecolor{rlVermelho}{HTML}{C1121F}
\definecolor{rlVerde}{HTML}{2B9348}
\definecolor{rlCinza}{HTML}{5C677D}
\definecolor{rlFundo}{HTML}{FAFBFC}
\definecolor{rlFundoQuiz}{HTML}{FFF8EE}
\hypersetup{colorlinks=true, allcolors=rlAzulClaro,
            pdftitle={Handout — Aprendizagem por Reforço}}

%% ------------------------------------------------------------
%% 2. TIPOGRAFIA
%% ------------------------------------------------------------
\IfFontExistsTF{Fira Sans}{%
  \setsansfont{Fira Sans}[
    ItalicFont     = Fira Sans Italic,
    BoldFont       = Fira Sans SemiBold,
    BoldItalicFont = Fira Sans SemiBold Italic]
}{\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{Fira Sans}{%
  \setmainfont{Fira Sans}[
    ItalicFont     = Fira Sans Italic,
    BoldFont       = Fira Sans SemiBold,
    BoldItalicFont = Fira Sans SemiBold Italic]
}{\setmainfont{TeX Gyre Heros}}
\IfFontExistsTF{Fira Mono}{\setmonofont{Fira Mono}[Scale=0.92]}%
  {\setmonofont{Latin Modern Mono}[Scale=0.92]}

\linespread{1.06}
\setlength{\parskip}{0.45em}
\setlength{\parindent}{0pt}
\setlist{leftmargin=1.25em, itemsep=0.15em, topsep=0.25em, parsep=0pt}
\setlist[itemize,1]{label=\textcolor{rlLaranja}{\footnotesize$\blacktriangleright$}}
\setlist[itemize,2]{label=\textcolor{rlTeal}{\footnotesize$\circ$}}
\setlist[enumerate,1]{label=\textcolor{rlLaranja}{\bfseries\arabic*.}}

%% ------------------------------------------------------------
%% 3. TÍTULOS DE SEÇÃO
%% ------------------------------------------------------------
\titleformat{\section}[hang]
  {\needspace{3\baselineskip}\normalfont\Large\bfseries\color{rlAzul}}
  {\colorbox{rlLaranja}{\color{white}\bfseries\;\thesection\;}\hspace{0.6em}}{0pt}{}
  [{\vspace{2pt}\color{rlAzul!22}\titlerule[0.8pt]}]
\titleformat{\subsection}[hang]
  {\needspace{2.5\baselineskip}\normalfont\large\bfseries\color{rlAzulClaro}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.35em}

%% ------------------------------------------------------------
%% 4. CABEÇALHO E RODAPÉ
%% ------------------------------------------------------------
\newcommand{\rlcurso}{Aprendizagem por Reforço}
\newcommand{\rlaula}{}
\newcommand{\rlprof}{}
\newcommand{\setaula}[1]{\renewcommand{\rlaula}{#1}}
\newcommand{\setprof}[1]{\renewcommand{\rlprof}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\footnotesize\color{rlCinza}\rlcurso\ \textbullet\ \rlaula}
\fancyhead[R]{\footnotesize\color{rlCinza}\rlprof}
\fancyfoot[C]{{\color{rlAzul!18}\rule{\linewidth}{0.8pt}}\\[2pt]
  \footnotesize\color{rlCinza}\thepage}

%% Faixa de título
\newcommand{\capa}[4]{% #1 título  #2 subtítulo  #3 autoria  #4 crédito
  \thispagestyle{empty}
  \noindent\begin{tcolorbox}[enhanced, colback=rlAzul, colframe=rlAzul,
    boxrule=0pt, arc=2mm, left=5mm, right=5mm, top=4mm, bottom=4mm,
    borderline south={2.6pt}{0pt}{rlLaranja}]
    {\footnotesize\color{rlAmbar}\bfseries\MakeUppercase{\rlcurso} \textbullet\ Universidade Federal de Uberlândia}\\[0.5em]
    {\LARGE\bfseries\color{white} #1}\\[0.35em]
    {\color{rlAmbar} #2}\\[0.8em]
    {\small\color{white!88!rlAzul} #3}\\[0.15em]
    {\footnotesize\color{white!68!rlAzul} #4}
  \end{tcolorbox}\vspace{0.4em}}

%% ------------------------------------------------------------
%% 5. CAIXAS TEMÁTICAS (mesmos nomes e cores do tema Beamer)
%% ------------------------------------------------------------
\tcbset{rlcaixa/.style={
  enhanced, boxrule=0pt, frame hidden, arc=1.4mm,
  left=2.6mm, right=2.6mm, top=1.4mm, bottom=1.6mm,
  boxsep=0.8mm, before skip=0.7em, after skip=0.8em,
  borderline west={2.4pt}{0pt}{#1},
  colback=rlFundo, breakable,
  fonttitle=\bfseries\small, coltitle=#1,
  attach title to upper={\par\vspace{0.4ex}},
  title after break={\textcolor{#1}{\itshape(continua)}},
}}

\newtcolorbox{defbox}[2][]{rlcaixa=rlTeal,
  title={Definição\ifblank{#2}{}{ — #2}}, #1}
\newtcolorbox{teobox}[2][]{rlcaixa=rlAzulClaro,
  title={#2}, colback=rlAzulClaro!6, #1}
\newtcolorbox{algbox}[2][]{rlcaixa=rlAzul,
  title={Algoritmo — #2}, colback=rlAzul!5, #1}
\newtcolorbox{ideiabox}[1][]{rlcaixa=rlAmbar,
  title={Intuição}, colback=rlAmbar!10, coltitle=rlLaranja, #1}
\newtcolorbox{alertabox}[1][]{rlcaixa=rlVermelho,
  title={Atenção}, colback=rlVermelho!5, #1}
\newtcolorbox{exbox}[2][]{rlcaixa=rlLaranja,
  title={Exercício #2}, colback=rlLaranja!6, #1}
\newtcolorbox{provabox}[1][]{rlcaixa=rlCinza,
  title={Demonstração}, colback=white, fontupper=\small, #1}

%% Pergunta para conduzir em aula
\newtcolorbox{discbox}[1][]{enhanced, breakable, arc=1.8mm, boxrule=0.8pt,
  colframe=rlAmbar!80!black, colback=rlFundoQuiz,
  left=2.6mm, right=2.6mm, top=2.4mm, bottom=1.8mm,
  fonttitle=\bfseries\small,
  attach boxed title to top left={xshift=3mm, yshift=-2.4mm},
  boxed title style={colback=rlLaranja, arc=1mm, boxrule=0pt,
                     left=1.6mm, right=1.6mm, top=0.7mm, bottom=0.7mm},
  coltitle=white, title={Para discutir em aula}, #1}

%% ------------------------------------------------------------
%% 6. MACROS MATEMÁTICAS (idênticas às do tema Beamer)
%% ------------------------------------------------------------
\newcommand{\E}{\mathbb{E}}
\newcommand{\Prob}{\mathbb{P}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\gS}{\mathcal{S}}
\newcommand{\gA}{\mathcal{A}}
\newcommand{\pol}{\pi}
\newcommand{\polstar}{\pi^{*}}
\newcommand{\Vpi}{V^{\pol}}
\newcommand{\Qpi}{Q^{\pol}}
\newcommand{\Vstar}{V^{*}}
\newcommand{\tran}[2]{P(#1\mid #2)}
\newcommand{\rec}{R}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\newcommand{\norminf}[1]{\norm{#1}_{\infty}}
\newcommand{\defeq}{\coloneqq}
\newcommand{\Var}{\operatorname{Var}}
\newcommand{\mdestaque}[2]{\colorbox{#1!14}{$\displaystyle #2$}}
\newcommand{\termo}[2]{\underbrace{#1}_{\substack{\text{\scriptsize\color{rlCinza}#2}}}}

%% ------------------------------------------------------------
%% 7. ESTILOS TIKZ
%% ------------------------------------------------------------
\tikzset{
  estado/.style={circle, draw=rlAzul, very thick, fill=rlAzul!8,
                 minimum size=8.5mm, inner sep=0pt, font=\small},
  estado destacado/.style={estado, fill=rlLaranja!18, draw=rlLaranja},
  estado terminal/.style={estado, double, double distance=1.1pt,
                          fill=rlVerde!12, draw=rlVerde!70!black},
  acaon/.style={circle, fill=rlAzul, minimum size=2.2mm, inner sep=0pt},
  trans/.style={-{Stealth[length=2.4mm]}, thick, rlCinza},
  trans destac/.style={trans, rlLaranja, very thick},
  probl/.style={font=\scriptsize, fill=white, inner sep=1pt, text=rlCinza},
  recomp/.style={font=\scriptsize\bfseries, text=rlVerde!70!black},
  caixa/.style={draw, thick, rounded corners=2pt, align=center, font=\scriptsize},
}
