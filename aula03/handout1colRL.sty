%% 9. ESTILOS TIKZ (mesmos nomes do deck)
%% ------------------------------------------------------------
\tikzset{
  estado/.style={circle, draw=rlAzul, very thick, fill=rlAzul!8,
                 minimum size=7mm, inner sep=0pt, font=\scriptsize},
  estado destacado/.style={estado, fill=rlLaranja!18, draw=rlLaranja},
  estado terminal/.style={estado, double, double distance=0.9pt,
                          fill=rlVerde!12, draw=rlVerde!70!black},
  acaon/.style={circle, fill=rlAzul, minimum size=1.8mm, inner sep=0pt},
  trans/.style={-{Stealth[length=2mm]}, thick, rlCinza},
  trans destac/.style={trans, rlLaranja, very thick},
  probl/.style={font=\tiny, fill=white, inner sep=1pt, text=rlCinza},
  recomp/.style={font=\tiny\bfseries, text=rlVerde!70!black},
}

%% Cadeia do Mars Rover.
%%   \marsrover{1,7}     destaca s1 e s7
%%   \marsrover{}        sem destaque
%%   \marsrover*{}       terminais em verde e rótulos de recompensa
%%   \marsrover[yshift=1mm]{}   opções do tikzpicture
%% Para encolher, use \scalebox — nunca `scale=`, que não reduz os nós.
\NewDocumentCommand{\marsrover}{s O{} m}{%
  \begin{tikzpicture}[node distance=3mm, #2]
    \IfBooleanTF{#1}{\def\rl@ext{estado terminal}}{\def\rl@ext{estado}}
    \foreach \i [count=\c] in {1,...,7}{%
      \ifnum\c=1
        \node[\rl@ext] (s\i) {$s_{\i}$};
      \else
        \pgfmathtruncatemacro{\prev}{\i-1}
        \ifnum\c=7
          \node[\rl@ext, right=of s\prev] (s\i) {$s_{\i}$};
        \else
          \node[estado, right=of s\prev] (s\i) {$s_{\i}$};
        \fi
      \fi}
    \foreach \i in {#3}{\node[estado destacado] at (s\i) {$s_{\i}$};}
    \IfBooleanT{#1}{%
      \node[font=\tiny, color=rlVerde!60!black, above=0.5mm of s1] {$+1$};
      \node[font=\tiny, color=rlVerde!60!black, above=0.5mm of s7] {$+10$};}
  \end{tikzpicture}}

%% Diagrama de backup de um passo
\newcommand{\backupdiagrama}{%
\begin{tikzpicture}[grow=down, level distance=9mm,
    level 1/.style={sibling distance=22mm},
    level 2/.style={sibling distance=10mm}]
  \node[estado destacado] {$s$}
    child {node[acaon] {}
      child {node[estado] {$s'$} edge from parent[trans]}
      child {node[estado] {$s'$} edge from parent[trans]}
      edge from parent[trans destac] node[left, font=\tiny, color=rlLaranja] {$a_1$}}
    child {node[acaon] {}
      child {node[estado] {$s'$} edge from parent[trans]}
      child {node[estado] {$s'$} edge from parent[trans]}
      edge from parent[trans destac] node[right, font=\tiny, color=rlLaranja] {$a_2$}};
\end{tikzpicture}}

%% ------------------------------------------------------------
%% 10. TABELAS
%%    \begin{tabelaRL}{especificação} ... \end{tabelaRL}
%%    Corpo em \footnotesize por padrão; o argumento opcional
%%    troca o corpo: \begin{tabelaRL}[\scriptsize]{lccc}
%%    Use \toprule / \midrule / \bottomrule do booktabs.
%%
%%    tabelaflex: mesma coisa, mas com colunas elásticas 'Y', que
%%    se ajustam sozinhas à largura da página. Prefira esta quando
%%    o mesmo fonte for compilado em larguras diferentes:
%%      \begin{tabelaflex}{@{}p{0.27\linewidth}YYY@{}} ...
%% ------------------------------------------------------------
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newenvironment{tabelaflex}[2][\footnotesize]
  {#1\setlength{\tabcolsep}{5pt}%
   \renewcommand{\arraystretch}{1.12}\tabularx{\linewidth}{#2}}
  {\endtabularx\par}
\newenvironment{tabelaRL}[2][\footnotesize]
  {#1\setlength{\tabcolsep}{5pt}%
   \renewcommand{\arraystretch}{1.12}\begin{tabular}{#2}}
  {\end{tabular}\par}
