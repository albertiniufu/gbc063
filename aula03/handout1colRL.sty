%% ============================================================
%%  handout1colRL.sty
%%  Folha de estudo (handout) de COLUNA ÚNICA para o curso de
%%  Aprendizagem por Reforço — pt-BR.
%%
%%  Irmão do handoutRL.sty (duas colunas) e companheiro do
%%  beamerthemeAprendizadoRL.sty: mesma paleta, mesmas macros
%%  matemáticas e MESMAS ASSINATURAS DE CAIXAS, de modo que
%%  trechos possam ser copiados entre o deck e os handouts sem
%%  edição nenhuma.
%%
%%  Este arquivo é autocontido: não depende do handoutRL.sty.
%%
%%  Compilar com XeLaTeX ou LuaLaTeX, DUAS vezes
%%  (a numeração "página/total" depende do lastpage).
%%
%%  ---------------------------------------------------------
%%  Uso mínimo:
%%
%%    \documentclass[a4paper, 11pt]{extarticle}
%%    \usepackage{handout1colRL}
%%    \usepackage{babel}
%%    \babelprovide[import, main]{brazilian}
%%
%%    \disciplina{Aprendizagem por Reforço}
%%    \rotulo{Folha de estudo}
%%    \title{Aula 3 — Avaliação de política sem modelo}
%%    \subtitulo{Subtítulo curto}
%%    \author{Prof.\ Marcelo Keese Albertini \textbullet\ UFU}
%%    \rodape{Aprendizagem por Reforço \textbullet\ Aula 3 \textbullet\ UFU}
%%
%%    \begin{document}
%%    \cabecalho
%%    \secao{Primeira seção} ...
%%    \end{document}
%%
%%  Use 11pt. As margens foram calculadas para dar uma medida de
%%  linha confortável nesse corpo (~75 caracteres).
%%
%%  ---------------------------------------------------------
%%  Opção 'notas': abre uma margem lateral larga para anotações
%%  do aluno, e habilita \aomargem{...} para notas laterais.
%%
%%    \usepackage[notas]{handout1colRL}
%%    ... texto ... \aomargem{Compare com a aula 2.}
%%
%%  Sem a opção, \aomargem cai para uma nota no corpo do texto,
%%  de modo que o mesmo fonte compila nos dois modos.
%%
%%  ---------------------------------------------------------
%%  Compatibilidade: o ambiente \begin{colunas}...\end{colunas}
%%  existe aqui como no-op. Assim, um handout escrito para o
%%  handoutRL.sty (duas colunas) compila em coluna única apenas
%%  trocando o nome do pacote no \usepackage.
%% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handout1colRL}[2026/08/09 Handout de coluna unica — Aprendizagem por Reforco]

