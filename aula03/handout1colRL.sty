  title after break={},
}}

% Definição formal — título vazio ⇒ escreve só "Definição"
\newtcolorbox{defbox}[2][]{rlcaixa=rlTeal,
  title={Definição\ifblank{#2}{}{ — #2}}, #1}
% Teorema / Proposição — título livre
\newtcolorbox{teobox}[2][]{rlcaixa=rlAzulClaro,
  title={#2}, colback=rlAzulClaro!6, #1}
% Algoritmo / pseudocódigo
\newtcolorbox{algbox}[2][]{rlcaixa=rlAzul,
  title={Algoritmo\ifblank{#2}{}{ — #2}}, colback=rlAzul!5, #1}
% Intuição (sem argumento obrigatório)
\newtcolorbox{ideiabox}[1][]{rlcaixa=rlAmbar,
  title={Intuição}, colback=rlAmbar!10, coltitle=rlLaranja, #1}
% Atenção / pegadinha (sem argumento obrigatório)
\newtcolorbox{alertabox}[1][]{rlcaixa=rlVermelho,
  title={Atenção}, colback=rlVermelho!5, #1}
% Exercício
\newtcolorbox{exbox}[2][]{rlcaixa=rlLaranja,
  title={Exercício #2}, colback=rlLaranja!6, #1}
% Resposta / gabarito
\newtcolorbox{respbox}[1][]{rlcaixa=rlVerde,
  title={Resposta}, colback=rlVerde!7, #1}
% Pergunta de participação, com selo
\newtcolorbox{quizbox}[2][]{enhanced, arc=1.6mm, boxrule=0.8pt,
  colframe=rlAmbar!80!black, colback=rlFundoQuiz,
  left=2mm, right=2mm, top=2.2mm, bottom=1.4mm,
  fonttitle=\bfseries\footnotesize,
  attach boxed title to top left={xshift=3mm, yshift=-2.2mm},
  boxed title style={colback=rlLaranja, arc=0.8mm, boxrule=0pt,
                     left=1.4mm, right=1.4mm, top=0.6mm, bottom=0.6mm},
  coltitle=white,
  title={Teste sua compreensão~~#2}, #1}

