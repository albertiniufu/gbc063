%% No modo 'notas' a faixa do cabeçalho avança sobre a margem
%% lateral, para não ficar espremida contra o texto.
\newcommand{\cabecalho}{%
  \ifrl@notas\noindent\makebox[\linewidth][l]{%
    \begin{minipage}{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}%
  \fi
  \begin{tcolorbox}[enhanced, boxrule=0pt, frame hidden, arc=1.6mm,
    colback=rlAzul, left=4mm, right=4mm, top=2.6mm, bottom=2.8mm,
    before skip=0pt, after skip=3mm]
    {\color{rlAmbar}\footnotesize\bfseries
      \MakeUppercase{\rl@disciplina}%
      \ifdefempty{\rl@rotulo}{}{\ \textbullet\ \MakeUppercase{\rl@rotulo}}}\\[0.35em]
    {\color{white}\LARGE\bfseries\@title}%
    \ifdefempty{\rl@subtitulo}{}{\\[0.3em]
      {\color{white!80!rlAzul}\small\rl@subtitulo}}%
    \ifdefempty{\@author}{}{\\[0.5em]
      {\color{white!62!rlAzul}\footnotesize\@author}}%
    \ifdefempty{\rl@creditos}{}{\\[0.15em]
      {\color{white!62!rlAzul}\footnotesize\rl@creditos}}%
  \end{tcolorbox}%
  \ifrl@notas\end{minipage}}\par\fi
}

