%% ============================================================
%%  beamerthemeAprendizadoRL.sty
%%  Tema Beamer para curso de Aprendizagem por Reforço (pt-BR)
%%  Baseado na estrutura do CS234 (Stanford), redesenhado.
%%  Compilar com XeLaTeX ou LuaLaTeX.
%% ============================================================
\ProvidesPackage{beamerthemeAprendizadoRL}[2026/08/08 Tema RL pt-BR]

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, shapes.geometric,
                decorations.pathmorphing, backgrounds, fit, chains}
\RequirePackage[most]{tcolorbox}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{fontspec}

%% ------------------------------------------------------------
%% 1. PALETA DE CORES
%% ------------------------------------------------------------
\definecolor{rlAzul}{HTML}{16324F}      % azul-profundo: cor primária
\definecolor{rlAzulClaro}{HTML}{2E5F8A} % azul médio
\definecolor{rlTeal}{HTML}{18808D}      % teal: definições / estrutura
\definecolor{rlLaranja}{HTML}{E8590C}   % laranja: destaque / ação
\definecolor{rlAmbar}{HTML}{F2A93B}     % âmbar: avisos suaves
\definecolor{rlVermelho}{HTML}{C1121F}  % alertas
\definecolor{rlVerde}{HTML}{2B9348}     % respostas corretas
\definecolor{rlCinza}{HTML}{5C677D}     % texto secundário
\definecolor{rlFundo}{HTML}{FAFBFC}     % fundo de caixas
\definecolor{rlFundoQuiz}{HTML}{FFF8EE} % fundo de perguntas

\setbeamercolor{normal text}{fg=black!85, bg=white}
\setbeamercolor{structure}{fg=rlAzul}
\setbeamercolor{alerted text}{fg=rlLaranja}
\setbeamercolor{example text}{fg=rlTeal}
\setbeamercolor{frametitle}{fg=rlAzul, bg=white}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=rlAmbar}
\setbeamercolor{author}{fg=white!90!rlAzul}
\setbeamercolor{institute}{fg=white!75!rlAzul}
\setbeamercolor{date}{fg=white!75!rlAzul}
\setbeamercolor{itemize item}{fg=rlLaranja}
\setbeamercolor{itemize subitem}{fg=rlTeal}
\setbeamercolor{itemize subsubitem}{fg=rlCinza}
\setbeamercolor{enumerate item}{fg=rlLaranja}
\setbeamercolor{footline}{fg=rlCinza}
\setbeamercolor{section in toc}{fg=rlAzul}
\setbeamercolor{caption name}{fg=rlTeal}
\setbeamercolor{button}{bg=rlFundo, fg=rlAzulClaro}

%% ------------------------------------------------------------
%% 2. TIPOGRAFIA (Fira Sans se instalada; senão TeX Gyre Heros)
%% ------------------------------------------------------------
\IfFontExistsTF{Fira Sans}{%
  \setsansfont{Fira Sans}[
    ItalicFont   = Fira Sans Italic,
    BoldFont     = Fira Sans SemiBold,
    BoldItalicFont = Fira Sans SemiBold Italic]
  \newfontfamily\rltitulofonte{Fira Sans SemiBold}
}{%
  \setsansfont{TeX Gyre Heros}
  \newfontfamily\rltitulofonte{TeX Gyre Heros Bold}
}
\IfFontExistsTF{Fira Mono}{\setmonofont{Fira Mono}}%
  {\setmonofont{Latin Modern Mono}}

\usefonttheme{professionalfonts}   % mantém a matemática clássica (LM Math)
\setbeamerfont{frametitle}{size=\large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small, series=\mdseries}
\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{caption}{size=\scriptsize}

%% ------------------------------------------------------------
%% 3. LAYOUT: margens, navegação, itens
%% ------------------------------------------------------------
\setbeamersize{text margin left=1.1em, text margin right=1.1em}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{itemize item}{\raisebox{0.12ex}{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raisebox{0.12ex}{\scriptsize$\circ$}}
\setbeamertemplate{itemize subsubitem}{--}
\setlength{\leftmargini}{1.2em}
\setlength{\leftmarginii}{1.1em}

%% Título do frame com filete de destaque
\setbeamertemplate{frametitle}{%
  \vskip 0.55em
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}%
  \ifx\insertframesubtitle\@empty\else
    \\[-0.1em]{\usebeamerfont{framesubtitle}\color{rlCinza}\insertframesubtitle}%
  \fi
  \vskip 0.18em
  {\color{rlLaranja}\rule{2.2em}{2.1pt}}%
  {\color{rlAzul!25}\rule{\dimexpr\linewidth-2.2em\relax}{0.6pt}}
  \vskip 0.35em
}

%% ------------------------------------------------------------
%% 4. RODAPÉ com barra de progresso
%% ------------------------------------------------------------
\newlength{\rl@pb}
\setbeamertemplate{footline}{%
  % barra de progresso
  \setlength{\rl@pb}{\paperwidth}%
  \ifnum\inserttotalframenumber>0
    \ifnum\insertframenumber<\inserttotalframenumber
      \setlength{\rl@pb}{\dimexpr\paperwidth/\inserttotalframenumber*\insertframenumber\relax}%
    \fi
  \fi
  \begin{beamercolorbox}[wd=\paperwidth]{footline}
    {\color{rlAzul!15}\rule{\paperwidth}{1.4pt}}\par\vskip-1.4pt
    {\color{rlLaranja}\rule{\rl@pb}{1.4pt}}\par
    \vskip 2.2pt
    \makebox[\paperwidth]{%
      \hspace{1.1em}%
      {\color{rlCinza}\insertshortauthor\ \textbullet\ \insertshorttitle}%
      \hfill
      {\color{rlCinza}\insertshortsubtitle}%
      \hfill
      {\color{rlAzul}\bfseries\insertframenumber}%
      {\color{rlCinza}\,/\,\inserttotalframenumber}%
      \hspace{1.1em}}%
    \vskip 3pt
  \end{beamercolorbox}%
}

%% ------------------------------------------------------------
%% 5. PÁGINA DE TÍTULO
%% ------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[rlAzul] (current page.south west) rectangle (current page.north east);
    % malha decorativa: grafo de estados estilizado
    \begin{scope}[opacity=0.14, shift={(current page.south east)}, x=1cm, y=1cm]
      \foreach \i/\p in {0/{-1.4,1.2}, 1/{-3.2,2.4}, 2/{-5.4,1.4},
                         3/{-2.2,4.0}, 4/{-4.8,3.6}, 5/{-6.9,2.8}}{
        \node[circle, draw=white, thick, minimum size=8mm] (n\i) at (\p) {};}
      \draw[white, thick, -{Stealth}] (n0) to[bend left=12] (n1);
      \draw[white, thick, -{Stealth}] (n1) to[bend left=12] (n2);
      \draw[white, thick, -{Stealth}] (n1) -- (n3);
      \draw[white, thick, -{Stealth}] (n3) -- (n4);
      \draw[white, thick, -{Stealth}] (n4) to[bend left=10] (n5);
      \draw[white, thick, -{Stealth}] (n2) to[bend left=14] (n5);
      \draw[white, thick, -{Stealth}] (n4) to[bend right=20] (n1);
    \end{scope}
    \node[anchor=west, text width=0.86\paperwidth]
      at ([xshift=1.1cm, yshift=0.72cm]current page.west) {%
      {\color{rlAmbar}\small\bfseries\insertinstitute}\\[0.9em]
      {\usebeamerfont{title}\color{white}\inserttitle}\\[0.7em]
      {\usebeamerfont{subtitle}\color{rlAmbar}\insertsubtitle}\\[2.2em]
      {\color{white!92!rlAzul}\insertauthor}\\[0.35em]
      {\color{white!70!rlAzul}\small\insertdate}};
  \end{tikzpicture}%
}

%% ------------------------------------------------------------
%% 6. PÁGINAS DE SEÇÃO
%% ------------------------------------------------------------
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[rlAzul] (current page.south west) rectangle (current page.north east);
    \node[anchor=east, color=rlAzulClaro!45, font=\fontsize{72}{72}\selectfont\bfseries]
      at ([xshift=-0.8cm, yshift=-0.4cm]current page.east)
      {\ifnum\thesection<10 0\fi\thesection};
    \node[anchor=west, text width=0.72\paperwidth]
      at ([xshift=1.1cm]current page.west) {%
        {\color{rlAmbar}\small\bfseries SEÇÃO \thesection}\\[0.55em]
        {\color{white}\LARGE\bfseries\insertsectionhead}\\[0.55em]
        {\color{rlLaranja}\rule{3em}{2.4pt}}};
  \end{tikzpicture}%
}
\AtBeginSection[]{\begin{frame}[plain, noframenumbering]\sectionpage\end{frame}}

%% ------------------------------------------------------------
%% 7. CAIXAS TEMÁTICAS (tcolorbox)
%% ------------------------------------------------------------
\tcbset{rlcaixa/.style={
  enhanced, boxrule=0pt, frame hidden, arc=1.6mm,
  left=2mm, right=2mm, top=1.1mm, bottom=1.2mm,
  boxsep=0.8mm, before skip=1mm, after skip=1.3mm,
  borderline west={2.4pt}{0pt}{#1},
  colback=rlFundo,
  fonttitle=\bfseries\small, coltitle=#1,
  attach title to upper={\par\vspace{0.35ex}},
  title after break={},
}}

% Definição formal
\newtcolorbox{defbox}[2][]{rlcaixa=rlTeal,
  title={Definição\ifblank{#2}{}{ — #2}}, #1}
% Teorema / Proposição
\newtcolorbox{teobox}[2][]{rlcaixa=rlAzulClaro,
  title={#2}, colback=rlAzulClaro!6, #1}
% Algoritmo
\newtcolorbox{algbox}[2][]{rlcaixa=rlAzul,
  title={Algoritmo — #2}, colback=rlAzul!5, #1}
% Insight / Intuição
\newtcolorbox{ideiabox}[1][]{rlcaixa=rlAmbar, fontupper=\small,
  title={Intuição}, colback=rlAmbar!10, coltitle=rlLaranja, #1}
% Atenção / pegadinha
\newtcolorbox{alertabox}[1][]{rlcaixa=rlVermelho, fontupper=\small,
  title={Atenção}, colback=rlVermelho!5, #1}
% Exercício
\newtcolorbox{exbox}[2][]{rlcaixa=rlLaranja,
  title={Exercício #2}, colback=rlLaranja!6, #1}

% Pergunta de participação (poll), com selo numerado
\newtcolorbox{quizbox}[2][]{enhanced, arc=2mm, boxrule=0.8pt,
  colframe=rlAmbar!80!black, colback=rlFundoQuiz,
  left=2mm, right=2mm, top=2.4mm, bottom=1.6mm,
  fonttitle=\bfseries\small,
  attach boxed title to top left={xshift=3mm, yshift=-2.6mm},
  boxed title style={colback=rlLaranja, arc=1mm, boxrule=0pt,
                     left=1.6mm, right=1.6mm, top=0.7mm, bottom=0.7mm},
  coltitle=white, fontupper=\small,
  title={Teste sua compreensão~~#2}, #1}

% Resposta (usar com \pause antes, para revelar)
\newtcolorbox{respbox}[1][]{rlcaixa=rlVerde, fontupper=\small,
  title={Resposta}, colback=rlVerde!7, #1}

% Alternativas de poll em linha
\newcommand{\alternativas}[1]{%
  {\small\color{rlCinza}\itshape Responda:\;}%
  {\small\color{rlAzul}\bfseries #1}}

%% ------------------------------------------------------------
%% 8. MACROS MATEMÁTICAS PADRONIZADAS (notação do curso)
%% ------------------------------------------------------------
\newcommand{\E}{\mathbb{E}}
\newcommand{\Prob}{\mathbb{P}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\gS}{\mathcal{S}}                       % espaço de estados
\newcommand{\gA}{\mathcal{A}}                       % espaço de ações
\newcommand{\pol}{\pi}
\newcommand{\polstar}{\pi^{*}}
\newcommand{\Vpi}{V^{\pol}}
\newcommand{\Qpi}{Q^{\pol}}
\newcommand{\Vstar}{V^{*}}
\newcommand{\tran}[2]{P(#1\mid #2)}                 % P(s'|s) ou P(s'|s,a)
\newcommand{\rec}{R}                                % recompensa
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\newcommand{\norminf}[1]{\norm{#1}_{\infty}}
\newcommand{\defeq}{\coloneqq}

% Destaque colorido em fórmulas: \mdestaque{cor}{conteúdo}
\newcommand{\mdestaque}[2]{%
  \mathchoice{\colorbox{#1!14}{$\displaystyle #2$}}%
             {\colorbox{#1!14}{$\textstyle #2$}}%
             {\colorbox{#1!14}{$\scriptstyle #2$}}%
             {\colorbox{#1!14}{$\scriptscriptstyle #2$}}}
% Anotação sob um termo: \termo{expressão}{rótulo}
\newcommand{\termo}[2]{\underbrace{#1}_{\substack{\text{\scriptsize\color{rlCinza}#2}}}}

%% ------------------------------------------------------------
%% 9. ESTILOS TIKZ PARA DIAGRAMAS DE RL
%% ------------------------------------------------------------
\tikzset{
  estado/.style={circle, draw=rlAzul, very thick, fill=rlAzul!8,
                 minimum size=8.5mm, inner sep=0pt, font=\small},
  estado destacado/.style={estado, fill=rlLaranja!18, draw=rlLaranja},
  estado terminal/.style={estado, double, double distance=1.1pt,
                          fill=rlVerde!12, draw=rlVerde!70!black},
  acaon/.style={circle, fill=rlAzul, minimum size=2.2mm, inner sep=0pt},
  trans/.style={-{Stealth[length=2.4mm]}, thick, rlCinza},
  trans destac/.style={trans, rlLaranja, very thick},
  probl/.style={font=\scriptsize, fill=white, inner sep=1pt, text=rlCinza},
  recomp/.style={font=\scriptsize\bfseries, text=rlVerde!70!black},
}

%% Cadeia do Mars Rover: \marsrover[opções tikzpicture]{destacados}
%%   #2 = lista de índices a destacar (ex.: {1,7}) — pode ser vazia
\newcommand{\marsrover}[2][]{%
\begin{tikzpicture}[node distance=4.2mm, #1]
  \foreach \i [count=\c] in {1,...,7}{%
    \ifnum\c=1
      \node[estado] (s\i) {$s_{\i}$};
    \else
      \pgfmathtruncatemacro{\prev}{\i-1}
      \node[estado, right=of s\prev] (s\i) {$s_{\i}$};
    \fi}
  \foreach \i in {#2}{\node[estado destacado] at (s\i) {$s_{\i}$};}
\end{tikzpicture}}

%% Diagrama de backup (1 passo): \backupdiagrama
\newcommand{\backupdiagrama}{%
\begin{tikzpicture}[grow=down, level distance=11mm,
    level 1/.style={sibling distance=26mm},
    level 2/.style={sibling distance=12mm}]
  \node[estado destacado] {$s$}
    child {node[acaon] (a1) {}
      child {node[estado] {$s'$} edge from parent[trans]}
      child {node[estado] {$s'$} edge from parent[trans]}
      edge from parent[trans destac] node[left, font=\scriptsize, color=rlLaranja] {$a_1$}}
    child {node[acaon] (a2) {}
      child {node[estado] {$s'$} edge from parent[trans]}
      child {node[estado] {$s'$} edge from parent[trans]}
      edge from parent[trans destac] node[right, font=\scriptsize, color=rlLaranja] {$a_2$}};
\end{tikzpicture}}
